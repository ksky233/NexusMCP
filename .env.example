NEXUSMCP_ENVIRONMENT=development
NEXUSMCP_LOG_LEVEL=INFO
NEXUSMCP_LOG_FORMAT=console
NEXUSMCP_TELEMETRY_ENABLED=false
NEXUSMCP_TELEMETRY_EXPORTER=none
# NEXUSMCP_TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:4318
NEXUSMCP_TELEMETRY_EXPORT_INTERVAL_MS=60000
NEXUSMCP_TELEMETRY_EXPORT_TIMEOUT_SECONDS=10.0
NEXUSMCP_UPSTREAM_EGRESS_POLICY_ENABLED=true
NEXUSMCP_UPSTREAM_ALLOWED_HOSTS=[]
NEXUSMCP_UPSTREAM_ALLOWED_CIDRS=[]
NEXUSMCP_UPSTREAM_ALLOWED_PORTS=[80,443,9001,9002,9003]
NEXUSMCP_UPSTREAM_ALLOW_LOCAL_DEMO=true
NEXUSMCP_CATALOG_BACKEND=postgresql
NEXUSMCP_TOOL_DISCOVERY_MODE=eager
NEXUSMCP_LOCAL_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXUSMCP_MCP_IDENTITY_MODE=static_service
NEXUSMCP_STATIC_AGENT_PRINCIPAL_ID=local-agent-service
NEXUSMCP_DATABASE_URL=postgresql+asyncpg://nexusmcp:nexusmcp_dev@127.0.0.1:55432/nexusmcp
NEXUSMCP_DATABASE_ECHO=false
NEXUSMCP_DATABASE_READINESS_TIMEOUT_SECONDS=1.0
NEXUSMCP_CONTROL_PLANE_ENABLED=true
NEXUSMCP_TOOL_EXECUTION_ENABLED=true
NEXUSMCP_TOOL_CALL_TIMEOUT_SECONDS=5.0
NEXUSMCP_TOOL_RETRY_MAX_ATTEMPTS=3
NEXUSMCP_TOOL_RETRY_INITIAL_BACKOFF_SECONDS=0.05
NEXUSMCP_APPROVAL_TTL_SECONDS=600.0
# Production/Multi-Worker 必须设置至少 32 Bytes 的共享 Key；不要提交真实值。
# NEXUSMCP_REQUEST_STATE_KEY=replace-with-a-secret-of-at-least-32-bytes
NEXUSMCP_ADMIN_IDENTITY_MODE=local
NEXUSMCP_LOCAL_ADMIN_PRINCIPAL_ID=local-admin
# Public Demo 使用独立部署模板；本地开发不要开启。
# NEXUSMCP_DEMO_ADMIN_PRINCIPAL_ID=public-demo-admin
NEXUSMCP_OPENAPI_FIXTURE_ROOT=examples/upstream_apis

# Integration tests must use a disposable database whose name includes "test".
NEXUSMCP_TEST_DATABASE_URL=postgresql+asyncpg://nexusmcp:nexusmcp_dev@127.0.0.1:55432/nexusmcp_test

NEXUSMCP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NEXUSMCP_EMBEDDING_DIMENSIONS=2048
NEXUSMCP_EMBEDDING_API_KEY=
NEXUSMCP_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
NEXUSMCP_EMBEDDING_TIMEOUT_SECONDS=60.0
NEXUSMCP_EMBEDDING_BATCH_SIZE=16
