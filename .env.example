NEXUSMCP_ENVIRONMENT=development
NEXUSMCP_LOG_LEVEL=INFO
NEXUSMCP_LOG_FORMAT=console
NEXUSMCP_CATALOG_BACKEND=postgresql
NEXUSMCP_LOCAL_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXUSMCP_DATABASE_URL=postgresql+asyncpg://nexusmcp:nexusmcp_dev@127.0.0.1:55432/nexusmcp
NEXUSMCP_DATABASE_ECHO=false
NEXUSMCP_DATABASE_READINESS_TIMEOUT_SECONDS=1.0
NEXUSMCP_CONTROL_PLANE_ENABLED=true
NEXUSMCP_TOOL_EXECUTION_ENABLED=true
NEXUSMCP_TOOL_CALL_TIMEOUT_SECONDS=5.0
NEXUSMCP_LOCAL_ADMIN_PRINCIPAL_ID=local-admin
NEXUSMCP_OPENAPI_FIXTURE_ROOT=examples/upstream_apis

# Integration tests must use a disposable database whose name includes "test".
NEXUSMCP_TEST_DATABASE_URL=postgresql+asyncpg://nexusmcp:nexusmcp_dev@127.0.0.1:55432/nexusmcp_test
