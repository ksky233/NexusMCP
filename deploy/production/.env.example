NEXUSMCP_BACKEND_IMAGE=nexusmcp-backend:local
NEXUSMCP_WEB_IMAGE=nexusmcp-web:local
NEXUSMCP_HTTP_PORT=18080
NEXUSMCP_POSTGRES_PASSWORD=replace_with_url_safe_random_password

NEXUSMCP_LOG_LEVEL=INFO
NEXUSMCP_LOG_FORMAT=json
NEXUSMCP_TELEMETRY_ENABLED=false
NEXUSMCP_TELEMETRY_EXPORTER=none

NEXUSMCP_LOCAL_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXUSMCP_DEMO_ADMIN_PRINCIPAL_ID=public-demo-admin
NEXUSMCP_STATIC_AGENT_PRINCIPAL_ID=public-demo-agent
NEXUSMCP_TOOL_DISCOVERY_MODE=eager
NEXUSMCP_TOOL_EXECUTION_ENABLED=true
NEXUSMCP_REQUEST_STATE_KEY=replace_with_random_value_of_at_least_32_bytes
NEXUSMCP_TOOL_CALL_TIMEOUT_SECONDS=5.0
NEXUSMCP_TOOL_RETRY_MAX_ATTEMPTS=3
NEXUSMCP_TOOL_RETRY_INITIAL_BACKOFF_SECONDS=0.05
NEXUSMCP_APPROVAL_TTL_SECONDS=600.0

NEXUSMCP_TRANSPORT_ALLOWED_HOSTS=["nexusmcp.dearloom.me","nexusmcp.dearloom.me:*","127.0.0.1","127.0.0.1:*","localhost","localhost:*"]
NEXUSMCP_TRANSPORT_ALLOWED_ORIGINS=["https://nexusmcp.dearloom.me"]

NEXUSMCP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NEXUSMCP_EMBEDDING_DIMENSIONS=2048
NEXUSMCP_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
NEXUSMCP_EMBEDDING_API_KEY=
NEXUSMCP_EMBEDDING_TIMEOUT_SECONDS=60.0
NEXUSMCP_EMBEDDING_BATCH_SIZE=16
